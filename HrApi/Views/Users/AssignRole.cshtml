@inject RoleManager<IdentityRole> RoleManager
@model ApplicationUser

@{
    ViewData["Title"] = "Assign Role";
    var roles = RoleManager.Roles.ToList();
    var message = TempData["SuccessMessage"] as string;
}
@if (!string.IsNullOrWhiteSpace(message))
{
    <partial name="_Alert" model="message" />
}
<h2>Assign Role</h2>

<form asp-action="AssignRole" asp-controller="Users" method="post">

    <input type="hidden" name="userId" value="@Model.Id" />

    <div class="form-group">
        <label>User</label>
        <input class="form-control" value="@Model.UserName" readonly />
    </div>

    <div class="form-group mt-3">
        <label>Select Role</label>
        <select name="roleName" class="form-control">
            @foreach (var role in roles)
            {
                <option value="@role.Name">@role.Name</option>
            }
        </select>
    </div>

    <button type="submit" class="btn btn-primary mt-3">
        Assign Role
    </button>
</form>

@if (!ViewData.ModelState.IsValid)
{
    <div class="text-danger mt-3">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@error.ErrorMessage</div>
        }
    </div>
}